# Server-only credentials. Copy defaults to .env.local and enter keys locally.
META_API_KEY=
META_TEXT_MODEL=muse-spark-1.3
META_TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
# Optional short-term Bedrock key for supervisor and software engineer only.
# Set the real key only in ignored .env.local; never in this example file.
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
SERPAPI_API_KEY=

# Request limits for the upcoming provider adapters, not an account spending cap.
AI_MAX_OUTPUT_TOKENS=3000
AI_REQUEST_TIMEOUT_MS=30000
SEARCH_MAX_QUERIES_PER_TASK=2
SEARCH_CACHE_TTL_SECONDS=86400

# Local data services. The app uses these loopback defaults if omitted.
REDIS_URL=redis://127.0.0.1:6379
MILVUS_ADDRESS=127.0.0.1:19530
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Optional SQLite file override; default is web/data/hacktx.sqlite.
# HACKTX_DB_PATH=
